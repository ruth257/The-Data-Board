# .env.example
# Shared API keys used server-side by the local dev server (server.ts), so
# you don't have to paste a key into the app itself. Which one is used
# depends on the provider selected in Settings (defaults to Claude).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
WEBSITE_API_KEY=
DATA_BOARD_KEY=
